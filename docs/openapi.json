{
  "openapi": "3.0.3",
  "info": {
    "title": "Unified Service Scheduler API",
    "version": "1.0.0",
    "description": "Book dealership service appointments against technician and service-bay availability."
  },
  "components": {
    "schemas": {
      "def-0": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "requestId": {
                "type": "string"
              }
            }
          }
        },
        "title": "ErrorResponse"
      },
      "def-1": {
        "type": "object",
        "required": [
          "id",
          "status",
          "dealershipId",
          "customerId",
          "vehicleId",
          "serviceTypeId",
          "technicianId",
          "serviceBayId",
          "startTime",
          "endTime",
          "createdAt",
          "cancelledAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "CONFIRMED"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "CANCELLED"
                ]
              }
            ]
          },
          "dealershipId": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "serviceTypeId": {
            "type": "string"
          },
          "technicianId": {
            "type": "string"
          },
          "serviceBayId": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "title": "Appointment"
      }
    }
  },
