    "/v1/dealerships/{dealershipId}/availability": {
      "get": {
        "summary": "List start times where a qualified technician and a bay are both free",
        "tags": [
          "availability"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "query",
            "name": "serviceTypeId",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "in": "query",
            "name": "date",
            "required": true,
            "description": "Local date at the dealership (YYYY-MM-DD)"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "dealershipId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "dealershipId",
                    "serviceTypeId",
                    "date",
                    "timezone",
                    "durationMinutes",
                    "slots"
                  ],
                  "properties": {
                    "dealershipId": {
                      "type": "string"
                    },
                    "serviceTypeId": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    },
                    "durationMinutes": {
                      "type": "integer"
                    },
                    "slots": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "startTime",
                          "endTime",
                          "availableTechnicians",
                          "availableBays"
                        ],
                        "properties": {
                          "startTime": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "endTime": {
