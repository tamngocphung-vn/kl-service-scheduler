# Reference: every variable the service reads. The real profiles are dev.env, pre-prod.env and
# prod.env in this folder. Personal overrides or real secrets go in config/local.env (git-ignored,
# loaded by the npm scripts after the profile), never in a profile.
# Precedence: shell variables, then local.env, then the profile.

APP_ENV=dev                          # dev | pre-prod | prod; logged at start-up
PORT=3000
DATABASE_PATH=./data/scheduler.db
LOG_LEVEL=info                       # trace | debug | info | warn | error
SEED_DEMO_DATA=false                 # true loads the demo dealerships (idempotent)

# --- OpenTelemetry tracing (D11) -----------------------------------------------------------------
# Off unless OTEL_TRACES_EXPORTER or OTEL_EXPORTER_OTLP_ENDPOINT is set.
#   Local simulation: OTEL_TRACES_EXPORTER=console prints spans to stdout (npm run start:otel-demo).
#   Managed service: set the OTLP endpoint and API key below.
OTEL_SERVICE_NAME=service-scheduler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.observability.example
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer FAKE-KEY-not-a-real-secret
# Metrics stay on Prometheus (/metrics) and logs on stdout, so the SDK exports traces only.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
