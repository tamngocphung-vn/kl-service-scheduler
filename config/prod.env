# Production (simulated): APP_ENV=prod docker compose up --build
# No demo data: the database starts empty and reference data comes from the DMS/CRM (A9).
APP_ENV=prod
PORT=3000
DATABASE_PATH=/data/scheduler.db
LOG_LEVEL=info
SEED_DEMO_DATA=false

OTEL_SERVICE_NAME=service-scheduler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
# SIMULATION ONLY: a fake endpoint (the reserved .example domain never resolves) and a FAKE key.
# Before go-live, the real key comes from a secret manager at deploy time, not from this file
# (docs/BUILD_FOR_THE_FUTURE.md §6, "Secrets").
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.prod.observability.example
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer FAKE-PROD-KEY-not-a-real-secret
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
