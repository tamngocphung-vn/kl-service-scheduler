# Pre-production (simulated): APP_ENV=pre-prod docker compose up --build
# Production-like settings with demo data, so the release can be checked end to end before prod.
APP_ENV=pre-prod
PORT=3000
DATABASE_PATH=/data/scheduler.db
LOG_LEVEL=info
SEED_DEMO_DATA=true

OTEL_SERVICE_NAME=service-scheduler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=pre-prod
# SIMULATION ONLY: a fake endpoint (the reserved .example domain never resolves).
# Profiles hold no secrets, not even fake ones. Before go-live, the API key (OTEL_EXPORTER_OTLP_HEADERS)
# is injected at deploy time from AWS Secrets Manager (D13, docs/BUILD_FOR_THE_FUTURE.md §6).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.pre-prod.observability.example
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
