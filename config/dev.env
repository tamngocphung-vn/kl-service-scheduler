# Local development: npm run dev / npm start. Contains no secrets.
APP_ENV=dev
PORT=3000
DATABASE_PATH=./data/scheduler.db
LOG_LEVEL=debug
SEED_DEMO_DATA=true

# Tracing is off in dev to keep the console readable. To see spans locally: npm run start:otel-demo
OTEL_SERVICE_NAME=service-scheduler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
