{
  "name": "service-scheduler",
  "version": "1.0.0",
  "description": "Unified Service Scheduler: books dealership service appointments against technician and service-bay availability",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=config/dev.env --env-file-if-exists=config/local.env src/server.ts",
    "start": "tsx --env-file=config/dev.env --env-file-if-exists=config/local.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "seed": "tsx --env-file=config/dev.env --env-file-if-exists=config/local.env scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "openapi": "tsx scripts/export-openapi.ts",
    "demo": "bash scripts/demo.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:toc": "doctoc README.md --github --minlevel 2 --maxlevel 3 --title '**Contents**'",
    "start:otel-demo": "OTEL_TRACES_EXPORTER=console tsx --env-file=config/dev.env --env-file-if-exists=config/local.env src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "prom-client": "^15.1.3",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "doctoc": "^2.5.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
